{
  // OPERATION MOONLIGHT — настройки редактора. Работает в VSCode и Cursor.

  // === C ===
  // Курс собирается с -std=gnu11: вызовы POSIX видны без ручных макросов.
  "C_Cpp.default.cStandard": "gnu11",
  "C_Cpp.default.compilerPath": "/usr/bin/gcc",
  "C_Cpp.default.intelliSenseMode": "gcc-x64",
  "C_Cpp.errorSquiggles": "enabled",
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "{ BasedOnStyle: LLVM, IndentWidth: 4, UseTab: Never, ColumnLimit: 100 }",

  // === Markdown ===
  // README, mission и theory рассчитаны на предпросмотр: Cmd+Shift+V / Ctrl+Shift+V.
  "markdown.preview.fontSize": 14,
  "markdown.preview.lineHeight": 1.6,
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": { "comments": "off", "strings": "off", "other": "off" }
  },
  "markdownlint.config": {
    "MD013": false,
    "MD033": false,
    "MD041": false
  },

  // === Редактор ===
  "editor.fontSize": 14,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  // Автоформатирование выключено: оно может переписать стартовый код до того,
  // как вы разберётесь, что в нём происходит.
  "editor.formatOnSave": false,
  "editor.rulers": [80, 100],
  "editor.renderWhitespace": "boundary",

  // === Файлы ===
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/*.o": true,
    "**/*.out": true,
    "**/a.out": true
  },

  "search.exclude": {
    "**/.git": true,
    "**/*.o": true,
    "**/*.out": true,
    // Эталоны исключены из поиска, чтобы не попадаться на глаза случайно.
    // Открыть их можно, но только осознанно — после честной попытки.
    "**/solution/**": true
  },

  // === Терминал ===
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 10000,

  // === Git ===
  // Ваш код в artifacts/ отслеживается: работайте в своей ветке.
  "git.autofetch": true,
  "git.confirmSync": false,

  // === Подсветка пометок ===
  "todohighlight.keywords": [
    { "text": "TODO:", "color": "#000", "backgroundColor": "#ffab00" },
    { "text": "FIXME:", "color": "#fff", "backgroundColor": "#f44336" },
    { "text": "NOTE:", "color": "#fff", "backgroundColor": "#2196f3" }
  ],

  "files.associations": {
    "*.c": "c",
    "*.h": "c",
    ".cursorrules": "plaintext",
    "Makefile": "makefile"
  }
}
